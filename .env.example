# ============================================================
# LEGALENS AI — Environment Configuration
# ============================================================

# Application
APP_NAME=LEGALENS AI
APP_ENV=development
SECRET_KEY=legalens_ai_production_grade_secret_key_change_in_prod_2026
JWT_SECRET=legalens_jwt_super_secret_signing_key_32_bytes_min
API_PORT=8000
FRONTEND_PORT=3000

# Database & Vector Strategy
# For PostgreSQL with pgvector in Docker/Cloud:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legalens
# Zero-dependency local development (Automatic fallback to SQLite + NumPy Cosine Engine):
DATABASE_URL=sqlite+aiosqlite:///./legalens.db

# Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# LLM Providers (At least one recommended for dynamic synthesis, with deterministic fallback)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Storage (Local path or S3/GCS)
STORAGE_PROVIDER=local
STORAGE_DIR=./data/uploads
STORAGE_BUCKET=legalens-documents-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Legal Source Verification & Freshness Defaults
SYNC_INTERVAL_MINUTES=60
LIVE_VERIFICATION_TIMEOUT_SECONDS=15
REAL_DATA_MODE_DEFAULT=true
DEMO_MODE_DEFAULT=false

# Security & Redaction
AUTO_REDACT_PII=true
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_MB=25
